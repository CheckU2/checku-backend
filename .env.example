APP_NAME=CheckU API
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
MONGODB_URI=
MONGODB_DATABASE=checku
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
INSTITUTIONAL_TIMEZONE=America/Mexico_City
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
PUBLIC_REGISTRATION_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
QR_CHALLENGE_TTL_SECONDS=60
UPLOAD_DIR=private_uploads
MAX_AVATAR_BYTES=4194304
